{
  "$defs": {
    "EdgeKind": {
      "enum": [
        "cites",
        "builds_on"
      ],
      "title": "EdgeKind",
      "type": "string"
    },
    "GraphEdge": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "$ref": "#/$defs/EdgeKind",
          "default": "cites"
        },
        "source": {
          "pattern": "^(arxiv|doi|openalex|s2):.+$",
          "title": "Source",
          "type": "string"
        },
        "target": {
          "pattern": "^(arxiv|doi|openalex|s2):.+$",
          "title": "Target",
          "type": "string"
        }
      },
      "required": [
        "source",
        "target"
      ],
      "title": "GraphEdge",
      "type": "object"
    },
    "GraphNode": {
      "additionalProperties": false,
      "properties": {
        "paper": {
          "$ref": "#/$defs/PaperRef"
        },
        "role": {
          "$ref": "#/$defs/NodeRole"
        }
      },
      "required": [
        "paper",
        "role"
      ],
      "title": "GraphNode",
      "type": "object"
    },
    "Links": {
      "additionalProperties": false,
      "properties": {
        "abstract_page": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Abstract Page"
        },
        "code": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Code"
        },
        "doi": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "pdf": {
          "anyOf": [
            {
              "format": "uri",
              "maxLength": 2083,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pdf"
        }
      },
      "title": "Links",
      "type": "object"
    },
    "NodeRole": {
      "enum": [
        "pick",
        "read_first",
        "foundation",
        "background",
        "reference",
        "citing"
      ],
      "title": "NodeRole",
      "type": "string"
    },
    "PaperIds": {
      "additionalProperties": false,
      "properties": {
        "arxiv": {
          "anyOf": [
            {
              "pattern": "^(\\d{4}\\.\\d{4,5}|[a-z-]+(\\.[A-Z]{2})?/\\d{7})$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Arxiv"
        },
        "doi": {
          "anyOf": [
            {
              "pattern": "^10\\.\\S+/\\S+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Doi"
        },
        "openalex": {
          "anyOf": [
            {
              "pattern": "^W\\d+$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Openalex"
        },
        "s2": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "S2"
        }
      },
      "title": "PaperIds",
      "type": "object"
    },
    "PaperRef": {
      "additionalProperties": false,
      "description": "A slim record of a referenced paper: enough to show it and link to it.",
      "properties": {
        "citations": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Citations"
        },
        "id": {
          "pattern": "^(arxiv|doi|openalex|s2):.+$",
          "title": "Id",
          "type": "string"
        },
        "ids": {
          "$ref": "#/$defs/PaperIds"
        },
        "influential_citations": {
          "anyOf": [
            {
              "minimum": 0,
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Influential Citations"
        },
        "is_review": {
          "default": false,
          "title": "Is Review",
          "type": "boolean"
        },
        "links": {
          "$ref": "#/$defs/Links"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        },
        "tldr": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Tldr"
        },
        "venue": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Venue"
        },
        "year": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Year"
        }
      },
      "required": [
        "id",
        "ids",
        "title"
      ],
      "title": "PaperRef",
      "type": "object"
    },
    "PickGraph": {
      "additionalProperties": false,
      "properties": {
        "citing_seen": {
          "default": 0,
          "minimum": 0,
          "title": "Citing Seen",
          "type": "integer"
        },
        "edges": {
          "items": {
            "$ref": "#/$defs/GraphEdge"
          },
          "title": "Edges",
          "type": "array"
        },
        "errors": {
          "items": {
            "type": "string"
          },
          "title": "Errors",
          "type": "array"
        },
        "nodes": {
          "items": {
            "$ref": "#/$defs/GraphNode"
          },
          "title": "Nodes",
          "type": "array"
        },
        "pick_id": {
          "pattern": "^(arxiv|doi|openalex|s2):.+$",
          "title": "Pick Id",
          "type": "string"
        }
      },
      "required": [
        "pick_id"
      ],
      "title": "PickGraph",
      "type": "object"
    }
  },
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "date": {
      "format": "date",
      "title": "Date",
      "type": "string"
    },
    "generated_at": {
      "format": "date-time",
      "title": "Generated At",
      "type": "string"
    },
    "graphs": {
      "items": {
        "$ref": "#/$defs/PickGraph"
      },
      "title": "Graphs",
      "type": "array"
    },
    "schema_version": {
      "const": 1,
      "default": 1,
      "title": "Schema Version",
      "type": "integer"
    }
  },
  "required": [
    "date",
    "generated_at"
  ],
  "title": "GraphFile",
  "type": "object"
}
